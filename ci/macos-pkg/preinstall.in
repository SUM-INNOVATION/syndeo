#!/bin/sh
# The shared helpers below are embedded whole; each script uses only some.
# shellcheck disable=SC2034,SC2329
# Syndeo.app's preinstall check.
#
# Installer runs it as root, after the person installing has authenticated
# and before anything is copied. It reads, and writes nothing: it stops the
# installation by exiting non-zero, and says why, one "syndeo preinstall:
# refusing: ..." line per reason. Installer normally records those lines in
# /var/log/install.log, but does not guarantee they appear there.
#
# The package installs /Applications/Syndeo.app and nothing else. Installer
# replaces a bundle that is running without stopping it, so this refuses
# while Syndeo or its helper runs from there. A postinstall that fails is not
# undone: the new bundle stays, under the receipt it replaced, and only the
# same package may finish it. With V this package's version, and P the
# bundle in /Applications:
# - no receipt and no P: install V;
# - no receipt, P exactly V: this package's own installation, interrupted;
#   resume it;
# - receipt X, P exactly X and listed exactly by it: upgrade to a newer V,
#   reinstall the same one, or refuse an older one;
# - receipt X, P gone (moved to the Trash): install V;
# - receipt X, P exactly a newer W: an upgrade to W failed. Only W's package
#   may finish it; any other is refused until it has.
# Anything else at P is refused: a bundle that is not Syndeo's, not exactly
# as packaged, changed since it was signed, or not what its receipt says.
# Move it to the Trash, and install again.
#
# And the discontinued v0.1.x command-line package, com.sum.syndeo.pkg: with
# no receipt for it, nothing in /usr/local is looked at, and nothing there is
# touched, whatever is there, the commands install.sh installs included. With
# its receipt, it has to be exactly as its package left it, for the
# postinstall to remove it; or, when P is already exactly V, what this
# package's own removal of it left when it stopped. Anything else is refused,
# and nothing of it is touched.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
LC_ALL=C
export PATH LC_ALL
umask 022
# Unset, IFS splits on space, tab and newline, whatever the caller set.
unset IFS CDPATH ENV BASH_ENV

SCRIPT=preinstall
INCOMING='@VERSION@'
ROOT='@ROOT@'
EXPECT_UID='@EXPECT_UID@'
EXPECT_GID='@EXPECT_GID@'
PKGUTIL='@PKGUTIL@'
CODESIGN='@CODESIGN@'

@COMMON@

# Where and on what.
if [ "${3-}" != / ]; then
    finding "the target volume is '${3-}': Syndeo installs only on the startup disk"
fi
if [ "$(/usr/bin/uname -m)" != arm64 ]; then
    finding "this Mac is not Apple Silicon"
fi
if ! syndeo_version_valid "$INCOMING"; then
    finding "this package's own version, '$INCOMING', is not a version"
fi
refuse_if_found

check_apps_dir
check_not_running
refuse_if_found

# ------------------------------------------------------------------ the app

decision=''
# yes when P is already exactly this version: the one case in which what is
# left of a v0.1.x removal may be this package's own.
is_incoming=no
read_app_receipt
if [ "$ar_present" = no ]; then
    if ! is_present "$APP"; then
        decision="installing $INCOMING"
    elif is_app_bundle "$INCOMING"; then
        decision="resuming an interrupted installation of $INCOMING"
        is_incoming=yes
    else
        found=$(app_info CFBundleShortVersionString)
        if syndeo_version_valid "$found" && is_app_bundle "$found"; then
            finding "$APP: is Syndeo.app $found, with no receipt. If the Syndeo $found package was interrupted installing it, install that package again; otherwise move it to the Trash, then install this package"
        else
            check_app_bundle "$INCOMING"
            finding "$APP: is there, and no Syndeo.app package installed it. Move it to the Trash, then install this package"
        fi
    fi
else
    check_app_receipt_meta
    refuse_if_found
    if ! is_present "$APP"; then
        decision="installing $INCOMING; Syndeo.app $ar_version, which the receipt names, is no longer in $APP_DIR"
    else
        found=$(app_info CFBundleShortVersionString)
        if syndeo_version_valid "$found" && [ "$found" != "$ar_version" ] &&
            [ "$(syndeo_version_cmp "$found" "$ar_version")" = gt ] && is_app_bundle "$found"; then
            # The receipt's version is gone, and exactly one newer version is
            # in its place: an upgrade to it whose postinstall failed.
            if [ "$INCOMING" = "$found" ]; then
                decision="completing the failed upgrade from $ar_version to $INCOMING"
                is_incoming=yes
            else
                finding "an upgrade from $ar_version to $found did not finish: install the Syndeo $found package again to complete it, then this one"
            fi
        else
            check_app_bundle "$ar_version"
            if [ "$nfindings" = 0 ] && [ "$app_ticket" != "$ar_ticket" ]; then
                if [ "$app_ticket" = yes ]; then
                    finding "$APP: holds a stapled ticket its receipt does not list"
                else
                    finding "$APP: lacks the stapled ticket its receipt lists"
                fi
            fi
            if [ "$nfindings" != 0 ]; then
                finding "$APP: is not Syndeo.app $ar_version as its package installed it. Move it to the Trash, then install this package"
            else
                case "$(syndeo_version_cmp "$INCOMING" "$ar_version")" in
                    lt)
                        finding "Syndeo.app $ar_version is installed, and this package is the older $INCOMING. Remove $ar_version first: run sudo /bin/sh $APP/Contents/Resources/uninstall.sh, or move Syndeo.app to the Trash"
                        ;;
                    eq)
                        decision="reinstalling $INCOMING"
                        is_incoming=yes
                        ;;
                    gt)
                        decision="upgrading from $ar_version to $INCOMING"
                        ;;
                esac
            fi
        fi
    fi
fi

# ------------------------------------------------------------------ v0.1.x

app_findings=$nfindings
legacy_plan "$is_incoming"
if [ "$nfindings" != "$app_findings" ]; then
    legacy_refusal
fi
refuse_if_found
case "$legacy" in
    whole) decision="$decision, and removing the v0.1.x command-line package $legacy_v" ;;
    partial) decision="$decision, and finishing the removal of the v0.1.x command-line package $legacy_v" ;;
esac
say "$decision"
exit 0
