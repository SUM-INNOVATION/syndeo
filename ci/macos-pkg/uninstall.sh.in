#!/bin/sh
# The shared helpers below are embedded whole; each script uses only some.
# shellcheck disable=SC2034,SC2329
# Remove Syndeo.app, installed by its macOS package.
#
#   sudo /bin/sh /Applications/Syndeo.app/Contents/Resources/uninstall.sh
#
# Only the copy inside the installed version removes it. It looks at
# everything first and changes nothing unless all of it is as the package
# left it: Syndeo not running, the receipt this package writes, for this
# version, listing exactly the bundle's paths, and the bundle exactly as
# packaged, its code signature intact. After a failed upgrade it refuses, and
# says to run that upgrade's package again first. Then it removes the
# bundle's files and directories, directories with rmdir, each looked at
# again just before; if one has changed since, it stops there and says what
# is left. Only once the bundle is gone is the receipt forgotten. If that
# fails, it says how, and exits 2.
#
# Never touched: ~/Library/Application Support/Syndeo, preferences, cookies,
# caches, search settings, any other user data, homes, keychain items, trust
# settings, /Applications itself, and any path not named above.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
LC_ALL=C
export PATH LC_ALL
umask 022
# Unset, IFS splits on space, tab and newline, whatever the caller set.
unset IFS CDPATH ENV BASH_ENV

SCRIPT=uninstall
EMBEDDED='@VERSION@'
ROOT='@ROOT@'
EXPECT_UID='@EXPECT_UID@'
EXPECT_GID='@EXPECT_GID@'
PKGUTIL='@PKGUTIL@'
CODESIGN='@CODESIGN@'

@COMMON@

case "$#:${1-}" in
    0:) ;;
    1:--help | 1:-h)
        cat <<EOF
Syndeo.app $EMBEDDED, installed by its macOS package in $APP_DIR.

There are two ways to remove it:

  sudo /bin/sh $APP/Contents/Resources/uninstall.sh
      Remove it completely: the application and the package's receipt.

  Move Syndeo.app to the Trash.
      The application goes; the package's receipt stays behind, harmlessly.
      Installing a Syndeo.app package later works the same either way.

Quit Syndeo first. Nothing is changed unless everything is as the package
left it. Your settings and data are kept, either way:
~/Library/Application Support/Syndeo, preferences, cookies, caches and
search settings are never touched, nor are keychain items or trust settings.
EOF
        exit 0
        ;;
    *)
        say "usage: sudo /bin/sh $APP/Contents/Resources/uninstall.sh [--help]"
        exit 1
        ;;
esac
if [ "$(/usr/bin/id -u)" != "$EXPECT_UID" ]; then
    say "refusing: run it as root, with sudo"
    exit 1
fi

# ------------------------------------------------------------------ look

check_apps_dir
check_not_running
refuse_if_found
read_app_receipt
if [ "$ar_present" = no ]; then
    say "refusing: no Syndeo.app package is installed. If Syndeo.app is in $APP_DIR without one, move it to the Trash"
    exit 1
fi
check_app_receipt_meta
refuse_if_found
if [ "$ar_version" != "$EMBEDDED" ]; then
    if [ "$(app_info CFBundleShortVersionString)" = "$EMBEDDED" ] &&
        [ "$(syndeo_version_cmp "$EMBEDDED" "$ar_version")" = gt ] && is_app_bundle "$EMBEDDED"; then
        say "refusing: the upgrade from $ar_version to $EMBEDDED did not finish. Install the Syndeo $EMBEDDED package again to complete it, then run this again"
    else
        say "refusing: this is the uninstaller of Syndeo.app $EMBEDDED, and the installed package is $ar_version. Run $APP/Contents/Resources/uninstall.sh"
    fi
    exit 1
fi
if ! is_present "$APP"; then
    say "refusing: $APP is not there; it may be in the Trash. Its receipt stays behind, harmlessly; to forget it too, run:"
    say "    sudo /usr/sbin/pkgutil --forget $APP_RECEIPT --volume /"
    exit 1
fi
check_app_bundle "$EMBEDDED"
refuse_if_found
if [ "$app_ticket" != "$ar_ticket" ]; then
    finding "$APP: its stapled ticket and its receipt disagree"
fi
refuse_if_found

# Everything that will be removed, as it is now: the files, the ticket if
# stapled, uninstall.sh last; then the directories, deepest first.
paths=$(
    app_manifest | while read -r p t m; do
        if [ "$t" = f ] && [ "$p" != Contents/Resources/uninstall.sh ]; then
            echo "$APP/$p"
        fi
    done
    if [ "$app_ticket" = yes ]; then
        echo "$APP/$APP_TICKET"
    fi
    echo "$APP/Contents/Resources/uninstall.sh"
    app_manifest | while read -r p t m; do
        if [ "$t" = d ]; then
            echo "$APP/$p"
        fi
    done | LC_ALL=C /usr/bin/sort -r
    echo "$APP"
)
snapshot=''
while IFS= read -r p; do
    snapshot="$snapshot
$p	$(meta_line "$p")"
done <<EOF
$paths
EOF

# ------------------------------------------------------------------ remove

removed=''

stop() {
    say "stopped: $1"
    if [ -n "$removed" ]; then
        say "already removed:$removed"
    fi
    say "the receipt was not forgotten; nothing else will be removed"
    exit 1
}

# remembered PATH: what PATH was when it was looked at, or nothing.
remembered() {
    _rm_found=''
    while IFS= read -r _rm_line; do
        case "$_rm_line" in
            "$1	"*) _rm_found=${_rm_line#"$1	"} ;;
        esac
    done <<EOF
$snapshot
EOF
    printf '%s' "$_rm_found"
}

# unchanged PATH: whether PATH is as it was when it was looked at. For a
# directory that is its own inode, owner, mode and flags; what it holds is
# checked file by file, and rmdir refuses anything left in it.
unchanged() {
    _uc_want=$(remembered "$1")
    [ -n "$_uc_want" ] && [ "$(meta_line "$1")" = "$_uc_want" ]
}

while IFS= read -r p; do
    unchanged "$p" || stop "$p changed after it was checked"
    load_meta "$p"
    if [ "$m_type" = Directory ]; then
        /bin/rmdir -- "$p" || stop "$p could not be removed: something unexpected is in it"
    else
        /bin/rm -f -- "$p" || stop "$p could not be removed"
    fi
    removed="$removed $p"
done <<EOF
$paths
EOF

# The bundle is gone; only now is the receipt forgotten.
if is_present "$APP"; then
    stop "$APP is still there"
fi
if ! "$PKGUTIL" --forget "$APP_RECEIPT" --volume / >/dev/null 2>&1; then
    say "Syndeo.app is removed, but the package's receipt could not be forgotten. Run:"
    say "    sudo /usr/sbin/pkgutil --forget $APP_RECEIPT --volume /"
    exit 2
fi
say "removed Syndeo.app $EMBEDDED. Your settings and data in ~/Library are kept"
exit 0
