#!/bin/sh
# The shared helpers below are embedded whole; each script uses only some.
# shellcheck disable=SC2034,SC2329
# Remove Syndeo, installed by its macOS package.
#
#   sudo /bin/sh /usr/local/libexec/syndeo/<version>/uninstall.sh
#
# One version is installed at a time, and only its own copy of this script,
# the one the receipt's version carries, removes it. It looks at everything
# first and changes nothing unless all of it is as the package left it: the
# receipt, every path the receipt lists, exactly as packaged, `current`
# pointing at it, and nothing else. After a failed upgrade it refuses, and
# says to run that upgrade's package again first. Then it removes the seven
# command links, `current`, the version's files, its directory and the
# private directory (directories with rmdir, so anything unexpected keeps its
# directory), and only then forgets the receipt. Each path is looked at again
# just before it is removed; if one has changed since, it stops there and
# says what is left.
#
# Never touched: homes, ~/.syndeo, keychain items, proxy trust settings, and
# any path not named above.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
LC_ALL=C
export PATH LC_ALL
umask 022
# Unset, IFS splits on space, tab and newline, whatever the caller set.
unset IFS CDPATH ENV BASH_ENV

SCRIPT=uninstall
EMBEDDED='@VERSION@'
ROOT='@ROOT@'
EXPECT_UID='@EXPECT_UID@'
EXPECT_GID='@EXPECT_GID@'
PKGUTIL='@PKGUTIL@'

@COMMON@

case "$#:${1-}" in
    0:) ;;
    1:--help | 1:-h)
        cat <<EOF
Syndeo $EMBEDDED, installed by its macOS package.

One version is installed, whole, in $SYNDEO_DIR/$EMBEDDED/, and the seven
commands in $SYNDEO_BIN lead to it through $SYNDEO_DIR/current. Quit Syndeo
before installing or upgrading. An upgrade removes this version and puts the
new one in its place: while it does, the commands do not start, and a Syndeo
left running from this version stops at the next program it needs, saying
it was removed during an upgrade; quit it and start it again. If an upgrade
fails, run the same package again to finish it.

  sudo /bin/sh $SYNDEO_DIR/$EMBEDDED/uninstall.sh
      Remove Syndeo: the seven commands, this version, and the receipt.

Nothing is changed unless everything is as the package left it. Homes,
~/.syndeo, keychain items and proxy trust settings are never touched.
EOF
        exit 0
        ;;
    *)
        say "usage: sudo /bin/sh $SYNDEO_DIR/$EMBEDDED/uninstall.sh [--help]"
        exit 1
        ;;
esac
if [ "$(/usr/bin/id -u)" != "$EXPECT_UID" ]; then
    say "refusing: run it as root, with sudo"
    exit 1
fi

# ------------------------------------------------------------------ look

read_receipt
if [ "$r_present" = no ]; then
    say "refusing: no Syndeo package is installed"
    exit 1
fi
check_receipt_meta
refuse_if_found
if [ "$r_version" != "$EMBEDDED" ]; then
    if [ -d "$SYNDEO_DIR/$EMBEDDED" ] && [ ! -e "$SYNDEO_DIR/$r_version" ] && [ ! -L "$SYNDEO_DIR/$r_version" ]; then
        say "refusing: the upgrade from $r_version to $EMBEDDED did not finish. Install the Syndeo $EMBEDDED package again to complete it, then run this again"
    else
        say "refusing: this is $EMBEDDED's uninstaller, and the installed package is $r_version. Run $SYNDEO_DIR/$r_version/uninstall.sh"
    fi
    exit 1
fi

check_strict_dir "$SYNDEO_LOCAL"
check_strict_dir "$SYNDEO_LIBEXEC"
check_bin_dir "$SYNDEO_BIN"
if ! is_present "$SYNDEO_DIR"; then
    finding "$SYNDEO_DIR: is missing"
fi
refuse_if_found
scan_private
scan_bin
refuse_if_found
# Exactly the receipt's version, every path it lists as packaged, and nothing
# else.
check_receipt_installed "$EMBEDDED"
if [ "$versions" != " $EMBEDDED" ]; then
    finding "$SYNDEO_DIR: holds${versions:- no version}; only $EMBEDDED may be there"
fi
if [ "$current_v" != "$EMBEDDED" ]; then
    finding "$SYNDEO_DIR/current: points at '${current_v}', not $EMBEDDED"
fi
case "$pending_v" in '' | "$EMBEDDED") ;; *) finding "$SYNDEO_DIR/.current.new: points at $pending_v, not $EMBEDDED" ;; esac
refuse_if_found

# Everything that will be removed, as it is now.
snapshot=''
remember() {
    snapshot="$snapshot
$1	$(meta_line "$1")"
}
for n in $SYNDEO_EXECUTABLES $SYNDEO_DOCUMENTS tools/wordcount.wat tools; do
    remember "$SYNDEO_DIR/$EMBEDDED/$n"
done
remember "$SYNDEO_DIR/$EMBEDDED"
for n in $SYNDEO_NAMES; do
    remember "$SYNDEO_BIN/$n"
done
remember "$SYNDEO_DIR/current"
if [ -n "$pending_v" ]; then
    remember "$SYNDEO_DIR/.current.new"
fi
remember "$SYNDEO_DIR"

# ------------------------------------------------------------------ remove

removed=''

stop() {
    say "stopped: $1"
    if [ -n "$removed" ]; then
        say "already removed:$removed"
    fi
    say "the receipt was not forgotten; nothing else will be removed"
    exit 1
}

# remembered PATH: what PATH was when it was looked at, or nothing.
remembered() {
    _rm_found=''
    while IFS= read -r _rm_line; do
        case "$_rm_line" in
            "$1	"*) _rm_found=${_rm_line#"$1	"} ;;
        esac
    done <<EOF
$snapshot
EOF
    printf '%s' "$_rm_found"
}

# unchanged PATH: whether PATH is as it was when it was looked at. For a
# directory that is its own inode, owner, mode and flags; what it holds is
# checked file by file, and rmdir refuses anything left in it.
unchanged() {
    _uc_want=$(remembered "$1")
    [ -n "$_uc_want" ] && [ "$(meta_line "$1")" = "$_uc_want" ]
}

remove_file() {
    unchanged "$1" || stop "$1 changed after it was checked"
    /bin/rm -f -- "$1" || stop "$1 could not be removed"
    removed="$removed $1"
}

remove_dir() {
    unchanged "$1" || stop "$1 changed after it was checked"
    /bin/rmdir -- "$1" || stop "$1 could not be removed: something unexpected is in it"
    removed="$removed $1"
}

for n in $SYNDEO_NAMES; do
    remove_file "$SYNDEO_BIN/$n"
done
remove_file "$SYNDEO_DIR/current"
if [ -n "$pending_v" ]; then
    remove_file "$SYNDEO_DIR/.current.new"
fi
# The version's files, uninstall.sh last, then its directories.
for n in $SYNDEO_NAMES $SYNDEO_DOCUMENTS tools/wordcount.wat; do
    remove_file "$SYNDEO_DIR/$EMBEDDED/$n"
done
remove_dir "$SYNDEO_DIR/$EMBEDDED/tools"
remove_file "$SYNDEO_DIR/$EMBEDDED/uninstall.sh"
remove_dir "$SYNDEO_DIR/$EMBEDDED"
remove_dir "$SYNDEO_DIR"

# Every path the receipt owns is gone; only now is it forgotten.
for n in $SYNDEO_NAMES; do
    if is_present "$SYNDEO_BIN/$n"; then
        stop "$SYNDEO_BIN/$n is still there"
    fi
done
if is_present "$SYNDEO_DIR"; then
    stop "$SYNDEO_DIR is still there"
fi
if ! "$PKGUTIL" --forget "$SYNDEO_ID" --volume / >/dev/null 2>&1; then
    say "every file is removed, but the receipt could not be forgotten. Run:"
    say "    sudo /usr/sbin/pkgutil --forget $SYNDEO_ID --volume /"
    exit 2
fi
say "removed Syndeo $EMBEDDED"
exit 0
