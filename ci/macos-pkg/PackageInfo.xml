<?xml version="1.0" encoding="utf-8"?>
<!--
  Handed to pkgbuild as its info template. Installer applies a payload's
  directory modes and owners to directories that already exist unless this is
  false, and the payload's root is /Applications itself: without it,
  installing could reset /Applications' owner and mode to the payload's.
-->
<pkg-info overwrite-permissions="false"/>
