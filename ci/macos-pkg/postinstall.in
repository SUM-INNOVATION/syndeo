#!/bin/sh
# The shared helpers below are embedded whole; each script uses only some.
# shellcheck disable=SC2034,SC2329
# Syndeo's postinstall step: make the version just installed the current one.
#
# Installer runs it as root once every file of the version is in place, and
# after it has removed the version this one replaces: one version is
# installed at a time. It checks that this version is complete, exactly as
# packaged, and the only one there, then points
# /usr/local/libexec/syndeo/current at it with a single rename. The commands
# in /usr/local/bin all lead through `current`, so a command that starts runs
# this version or, before the switch, none: from the removal of the previous
# version until this switch, commands fail to start with "No such file or
# directory" (or, at the switch itself, "Invalid argument"). Once this step
# returns, `current` is this version and every command starts. A Syndeo still
# running from the removed version stops at the next program it needs, and
# has to be quit and started again; quit Syndeo before installing.
#
# If anything is wrong it switches nothing, and exits non-zero. Installer
# then writes no receipt, so the receipt still names the removed version and
# running this same package again finishes the upgrade.
#
# It touches nothing outside the private directory: no command link, no home,
# no keychain, no trust setting.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
LC_ALL=C
export PATH LC_ALL
umask 022
# Unset, IFS splits on space, tab and newline, whatever the caller set.
unset IFS CDPATH ENV BASH_ENV

SCRIPT=postinstall
INCOMING='@VERSION@'
ROOT='@ROOT@'
EXPECT_UID='@EXPECT_UID@'
EXPECT_GID='@EXPECT_GID@'
PKGUTIL='@PKGUTIL@'

@COMMON@

if [ "${3-}" != / ]; then
    finding "the target volume is '${3-}': Syndeo installs only on the startup disk"
fi
if ! syndeo_version_valid "$INCOMING"; then
    finding "this package's own version, '$INCOMING', is not a version"
fi
refuse_if_found

check_strict_dir "$SYNDEO_LOCAL"
check_strict_dir "$SYNDEO_LIBEXEC"
if is_present "$SYNDEO_DIR"; then
    check_strict_dir "$SYNDEO_DIR"
else
    finding "$SYNDEO_DIR: is missing"
fi
refuse_if_found

check_tree "$INCOMING" exact
for entry in "$SYNDEO_DIR"/* "$SYNDEO_DIR"/.[!.]* "$SYNDEO_DIR"/..?*; do
    is_present "$entry" || continue
    case "${entry##*/}" in
        "$INCOMING" | current | .current.new) ;;
        *) finding "$entry: is still there; Syndeo $INCOMING is installed alone" ;;
    esac
done
for link in current .current.new; do
    path="$SYNDEO_DIR/$link"
    is_present "$path" || continue
    if ! is_private "$path" 'Symbolic Link' -; then
        finding "$path: is not a symlink owned by root:wheel"
    elif ! syndeo_version_valid "$(/usr/bin/readlink "$path")"; then
        finding "$path: does not point at a version"
    fi
done
refuse_if_found

# A temporary link left by a switch that was interrupted.
if is_present "$SYNDEO_DIR/.current.new"; then
    /bin/rm -f -- "$SYNDEO_DIR/.current.new"
fi
/bin/ln -s "$INCOMING" "$SYNDEO_DIR/.current.new"
# -h: rename over `current` itself, not into the directory it points at.
/bin/mv -h -f "$SYNDEO_DIR/.current.new" "$SYNDEO_DIR/current"

if [ "$(/usr/bin/readlink "$SYNDEO_DIR/current")" != "$INCOMING" ]; then
    say "refusing: $SYNDEO_DIR/current does not point at $INCOMING after the switch"
    exit 1
fi
say "$INCOMING is current. Commands did not start while the previous version was replaced; a Syndeo still running from it has to be quit and started again"
exit 0
